# Server Configuration
PORT=5000
NODE_ENV=production

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# External AI / Scraping APIs
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest
APIFY_API_TOKEN=your_apify_api_token

# Frontend Allowed Origin for CORS
# Production on Render: Set this to your actual Netlify frontend URL
# FRONTEND_URL=https://your-site.netlify.app
# Local development:
# FRONTEND_URL=http://localhost:3000
FRONTEND_URL=https://your-site.netlify.app

# Python FastAPI Intelligence Service URL
# Production on Render:
# ML_SERVICE_URL=https://socialintel-ml.onrender.com
# Local development:
# ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_URL=https://socialintel-ml.onrender.com
